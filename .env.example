# Neon Postgres (set after Task 3 provisions DB)
DATABASE_URL=postgres://...

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# Recraft V3 (direct API at recraftapi.com; alternatively use REPLICATE_API_TOKEN if going through Replicate)
RECRAFT_API_KEY=...

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auth
APP_PASSWORD=change-me-locally
AUTH_COOKIE_SECRET=$(openssl rand -hex 32)

# Optional: Printify (Plan 2 will use these — fine to leave empty for now)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional: Etsy Open API v3 for competitive pricing data (Plan 3)
# Apply at https://www.etsy.com/developers/your-apps — approval takes a few days.
# Etsy issues BOTH a keystring AND a shared secret. Both are required:
# the x-api-key header is sent as "keystring:shared_secret" (colon-joined).
# Public listing search needs no per-shop OAuth — just these two values.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
USE_ETSY_OPEN_API=false

# Dormant: eRank scaffold (eRank has no API as of 2026-05; left wired for
# future pivot if needed).
ERANK_API_KEY=
USE_ERANK=false
