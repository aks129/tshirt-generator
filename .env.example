# Neon Postgres (set after Task 3 provisions DB)
DATABASE_URL=postgres://...

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# Recraft V3 (direct API at recraftapi.com; alternatively use REPLICATE_API_TOKEN if going through Replicate)
RECRAFT_API_KEY=...

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Auth
APP_PASSWORD=change-me-locally
AUTH_COOKIE_SECRET=$(openssl rand -hex 32)

# Optional: Printify (Plan 2 will use these — fine to leave empty for now)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Optional: eRank API for competitive pricing data (Plan 3)
# Sign up at erank.com → upgrade to Expert tier → get API key.
# When set with USE_ERANK=true, replaces the public-search scraper.
ERANK_API_KEY=
USE_ERANK=false
