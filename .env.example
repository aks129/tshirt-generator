# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (the app uses node-postgres / pg). Any Postgres
# works; the project was built on Neon. Get one at https://neon.tech
DATABASE_URL=postgres://user:password@host/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
APP_PASSWORD=change-me                 # single shared login password
AUTH_COOKIE_SECRET=                     # jose signing key, >=32 chars: openssl rand -hex 32
CRON_SECRET=                            # bearer token guarding /api/cron/* (set in your cron config)

# ── AI providers ──────────────────────────────────────────────────────────────
# Gemini is primary (free tier); Groq is the automatic fallback on 429/5xx.
GEMINI_API_KEY=                         # https://aistudio.google.com/apikey
GROQ_API_KEY=                           # optional; https://console.groq.com/keys
RECRAFT_API_KEY=                        # image generation (paid); https://www.recraft.ai

# ── Vercel Blob (print-ready PNG storage) ─────────────────────────────────────
# Read automatically by @vercel/blob; set in Vercel or pull with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# ── Printify (publish target) ─────────────────────────────────────────────────
PRINTIFY_API_KEY=                       # Printify account API token
PRINTIFY_SHOP_ID=                       # numeric shop id of the connected Etsy store
PRINTIFY_USER_AGENT=                    # optional UA on Printify requests, e.g. "myapp/1.0 (you@example.com)"

# ── Etsy (competitive pricing via official Open API; optional) ────────────────
# Etsy issues BOTH a keystring and a shared secret; the x-api-key header is sent
# as "keystring:shared_secret". When USE_ETSY_OPEN_API is not "true", the app
# falls back to public-search scraping. (Seller OAuth tokens for photo upload are
# stored in the database via the in-app Etsy connect flow, not here.)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
USE_ETSY_OPEN_API=false
